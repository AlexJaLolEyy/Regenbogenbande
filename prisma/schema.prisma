// This is your Prisma schema file
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// ROLE ENUM (for better-auth)
// ============================================
// Note: 'guest' is runtime-only (anonymous sessions, no DB user)
// Note: 'owner' is application-level check via OWNER_USER_ID env var
enum Role {
  admin
  member
}

// ============================================
// USER STATUS ENUM
// ============================================
enum UserStatus {
  INVITED   // Created via invite, hasn't logged in
  ACTIVE    // Has logged in at least once
  DISABLED  // Soft-deleted, content preserved
}

// ============================================
// CATEGORY MODEL
// ============================================
model Category {
  id      String  @id @default(cuid())
  name    String  @unique
  iconUrl String? // Small icon stored in R2/local

  videos   Video[]
  pictures Picture[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("categories")
}

// ============================================
// USER MODEL
// ============================================
// Integrated with better-auth
model User {
  id            String   @id @default(cuid())
  name          String                          // Display name (from Discord)
  email         String?  @unique
  emailVerified Boolean  @default(false)        // Required for better-auth
  image         String?                         // Profile picture URL
  role          Role     @default(member)       // Role-based access control (only invited users get DB records)
  status        UserStatus @default(INVITED)
  isAnonymous   Boolean  @default(false)        // Required for better-auth anonymous plugin

  // Discord-specific fields
  discordId String? @unique // For invite verification

  // Relationships - these define how User connects to other models
  uploadedVideos   Video[]   @relation("VideoUploader")
  uploadedPictures Picture[] @relation("PictureUploader")
  uploadedQuotes   Quote[]   @relation("QuoteUploader")

  // Many-to-many relationships (participants)
  videoParticipants   VideoParticipant[]
  pictureParticipants PictureParticipant[]
  quoteParticipants   QuoteParticipant[]

  // Ratings given by this user
  ratings Rating[]

  // Comments and votes
  comments     Comment[]
  commentVotes CommentVote[]

  // Quote messages written by this user
  quoteMessages QuoteMessage[]

  // Seen/unseen tracking
  videoViews   UserVideoView[]
  pictureViews UserPictureView[]

  // better-auth relations
  accounts Account[]
  sessions Session[]

  // Claimed participant placeholders (one user may claim multiple)
  claimedPlaceholders ParticipantPlaceholder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users") // Maps to "users" table in database
}

// ============================================
// VIDEO MODEL
// ============================================
model Video {
  id           String  @id @default(cuid())
  title        String
  description  String?
  videoUrl     String
  thumbnailUrl String

  // Foreign keys - who uploaded this
  uploadedById String
  uploadedBy   User   @relation("VideoUploader", fields: [uploadedById], references: [id])

  // Category (required - user must select on upload)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  // Timestamps
  uploadedAt DateTime @default(now())
  createdAt  DateTime

  // Relationships
  participants VideoParticipant[]
  ratings      Rating[]
  userViews    UserVideoView[]
  comments     Comment[]

  // Metadata (stored directly, not in separate table for simplicity)
  views Int @default(0)

  // Visibility (curation system)
  isPublic    Boolean   @default(false) // Content is private by default
  publishedAt DateTime?                 // When content was published (null = never)

  updatedAt DateTime @updatedAt

  @@index([uploadedById]) // Index for faster queries
  @@index([createdAt]) // Index for sorting by date
  @@index([categoryId]) // Index for category filtering
  @@index([isPublic]) // Index for visibility filtering
  @@map("videos")
}

// ============================================
// PICTURE MODEL
// ============================================
model Picture {
  id           String  @id @default(cuid())
  title        String
  description  String?
  imageUrl     String
  thumbnailUrl String

  uploadedById String
  uploadedBy   User   @relation("PictureUploader", fields: [uploadedById], references: [id])

  // Category (required - user must select on upload)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  uploadedAt DateTime @default(now())
  createdAt  DateTime

  participants PictureParticipant[]
  ratings      Rating[]
  userViews    UserPictureView[]
  comments     Comment[]

  views Int @default(0)

  // Visibility (curation system)
  isPublic    Boolean   @default(false) // Content is private by default
  publishedAt DateTime?                 // When content was published (null = never)

  updatedAt DateTime @updatedAt

  @@index([uploadedById])
  @@index([createdAt])
  @@index([categoryId]) // Index for category filtering
  @@index([isPublic]) // Index for visibility filtering
  @@map("pictures")
}

// ============================================
// QUOTE MODEL
// ============================================
model Quote {
  id String @id @default(cuid())

  uploadedById String
  uploadedBy   User   @relation("QuoteUploader", fields: [uploadedById], references: [id])

  uploadedAt DateTime @default(now())
  createdAt  DateTime

  participants QuoteParticipant[]
  ratings      Rating[]
  messages     QuoteMessage[]
  comments     Comment[]

  views Int @default(0)

  // Visibility (curation system)
  isPublic    Boolean   @default(false) // Content is private by default
  publishedAt DateTime?                 // When content was published (null = never)

  updatedAt DateTime @updatedAt

  @@index([uploadedById])
  @@index([createdAt])
  @@index([isPublic]) // Index for visibility filtering
  @@map("quotes")
}

// ============================================
// QUOTE MESSAGE MODEL
// ============================================
// Each quote has multiple messages (chat history)
model QuoteMessage {
  id      String @id @default(cuid())
  message String

  quoteId String
  quote   Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@index([quoteId])
  @@index([userId])
  @@map("quote_messages")
}

// ============================================
// RATING MODEL
// ============================================
// Separate table for ratings (can rate videos, pictures, quotes)
model Rating {
  id    String @id @default(cuid())
  value Float

  userId String
  user   User   @relation(fields: [userId], references: [id])

  // Polymorphic relations - rating can be for Video, Picture, or Quote
  videoId String?
  video   Video?  @relation(fields: [videoId], references: [id], onDelete: Cascade)

  pictureId String?
  picture   Picture? @relation(fields: [pictureId], references: [id], onDelete: Cascade)

  quoteId String?
  quote   Quote?  @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Ensure one rating per user per item
  @@unique([userId, videoId])
  @@unique([userId, pictureId])
  @@unique([userId, quoteId])
  @@index([videoId])
  @@index([pictureId])
  @@index([quoteId])
  @@map("ratings")
}

// ============================================
// COMMENT MODEL
// ============================================
model Comment {
  id      String @id @default(cuid())
  content String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Polymorphic: belongs to Video OR Picture (XOR at app level)
  videoId String?
  video   Video?  @relation(fields: [videoId], references: [id], onDelete: Cascade)

  pictureId String?
  picture   Picture? @relation(fields: [pictureId], references: [id], onDelete: Cascade)

  quoteId String?
  quote   Quote?  @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  // Self-reference for replies
  parentId String?
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[] @relation("CommentReplies")

  votes CommentVote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([videoId])
  @@index([pictureId])
  @@index([quoteId])
  @@index([userId])
  @@index([parentId])
  @@map("comments")
}

// ============================================
// COMMENT VOTE MODEL
// ============================================
model CommentVote {
  id    String @id @default(cuid())
  value Int // +1 for upvote, -1 for downvote

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  commentId String
  comment   Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, commentId])
  @@index([commentId])
  @@map("comment_votes")
}

// ============================================
// PARTICIPANT PLACEHOLDER MODEL
// ============================================
// Allows creating participants before user login via invite placeholders
model ParticipantPlaceholder {
  id          String   @id @default(cuid())
  displayName String   // Name shown before user claims

  discordId String? // Optional: link to future Discord login (NOT unique - multiple placeholders can share)

  // User who claimed this placeholder (NOT unique: one user may claim multiple placeholders)
  claimedById String?
  claimedBy   User?  @relation(fields: [claimedById], references: [id])

  // Reverse relations for junction tables
  videoParticipants   VideoParticipant[]
  pictureParticipants PictureParticipant[]
  quoteParticipants   QuoteParticipant[]

  createdAt DateTime @default(now())

  @@index([claimedById])
  @@index([discordId])
  @@map("participant_placeholders")
}

// ============================================
// MANY-TO-MANY JUNCTION TABLES
// ============================================
// These handle the "participants" relationship
// (Many users can participate in many videos/pictures/quotes)
// XOR: exactly one of userId or placeholderId must be set (validated at application level)

model VideoParticipant {
  id String @id @default(cuid())

  videoId String
  video   Video  @relation(fields: [videoId], references: [id], onDelete: Cascade)

  // XOR: exactly one must be set (validated at application level)
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  placeholderId String?
  placeholder   ParticipantPlaceholder? @relation(fields: [placeholderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  // Unique per video-user OR video-placeholder (nulls handled by app)
  @@unique([videoId, userId])
  @@unique([videoId, placeholderId])
  @@index([videoId])
  @@index([userId])
  @@index([placeholderId])
  @@map("video_participants")
}

model PictureParticipant {
  id String @id @default(cuid())

  pictureId String
  picture   Picture @relation(fields: [pictureId], references: [id], onDelete: Cascade)

  // XOR: exactly one must be set (validated at application level)
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  placeholderId String?
  placeholder   ParticipantPlaceholder? @relation(fields: [placeholderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  // Unique per picture-user OR picture-placeholder (nulls handled by app)
  @@unique([pictureId, userId])
  @@unique([pictureId, placeholderId])
  @@index([pictureId])
  @@index([userId])
  @@index([placeholderId])
  @@map("picture_participants")
}

model QuoteParticipant {
  id String @id @default(cuid())

  quoteId String
  quote   Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  // XOR: exactly one must be set (validated at application level)
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  placeholderId String?
  placeholder   ParticipantPlaceholder? @relation(fields: [placeholderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  // Unique per quote-user OR quote-placeholder (nulls handled by app)
  @@unique([quoteId, userId])
  @@unique([quoteId, placeholderId])
  @@index([quoteId])
  @@index([userId])
  @@index([placeholderId])
  @@map("quote_participants")
}

// ============================================
// USER VIDEO VIEW (seen/unseen tracking)
// ============================================
model UserVideoView {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  videoId String
  video   Video  @relation(fields: [videoId], references: [id], onDelete: Cascade)

  viewedAt DateTime @default(now())

  @@unique([userId, videoId])
  @@index([userId])
  @@index([videoId])
  @@map("user_video_views")
}

// ============================================
// USER PICTURE VIEW (seen/unseen tracking)
// ============================================
model UserPictureView {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  pictureId String
  picture   Picture @relation(fields: [pictureId], references: [id], onDelete: Cascade)

  viewedAt DateTime @default(now())

  @@unique([userId, pictureId])
  @@index([userId])
  @@index([pictureId])
  @@map("user_picture_views")
}

// ============================================
// BETTER-AUTH MODELS
// ============================================
// Required models for better-auth with Prisma adapter

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String    // Provider's user ID (Discord user ID)
  providerId            String    // "discord"
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?   @db.Text

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique // Session token
  expiresAt DateTime
  ipAddress String?
  userAgent String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("sessions")
}

// ============================================
// VERIFICATION MODEL (required by better-auth)
// ============================================
model Verification {
  id         String   @id @default(cuid())
  identifier String   // Email or other identifier
  value      String   // Verification token
  expiresAt  DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("verification")
}

// ============================================
// INVITE MODEL (for invite-only access)
// ============================================
model Invite {
  id          String    @id @default(cuid())
  discordId   String    @unique // Discord user ID to allow
  discordName String?            // Display name (for admin reference)
  role        Role      @default(member) // Role to assign on first login
  usedAt      DateTime?          // When they first logged in
  createdById String?            // Admin who created invite

  createdAt DateTime @default(now())

  @@map("invites")
}
